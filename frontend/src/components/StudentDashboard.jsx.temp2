              <ErrorBoundary>
                <div className="space-y-4">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-4">
                      <Badge variant="outline" className="text-base px-4 py-1">
                        {myCourses && myCourses[0] ? myCourses[0].title : '课程'}练习
                      </Badge>
                      <div className="flex items-center gap-2 text-sm text-gray-600">
                        <span>答题进度</span>
                        <Progress 
                          value={practiceQuestions && practiceQuestions.length > 0 ? (practiceQuestions.filter(q => q && q.userAnswer !== null).length / practiceQuestions.length) * 100 : 0} 
                          className="w-32 h-2"
                        />
                        <span>{practiceQuestions.filter(q => q && q.userAnswer !== null).length} / {practiceQuestions.length}</span>
                      </div>
                    </div>
                  </div>

                  <Card className="overflow-hidden">
                  <div className="bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-4">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-bold text-lg">
                          {practiceQuestions && practiceQuestions.length > 0 ? Math.min(currentQuestionIndex + 1, practiceQuestions.length) : 1}
                        </div>
                        <div>
                          <p className="text-blue-100 text-sm">第 {practiceQuestions && practiceQuestions.length > 0 ? Math.min(currentQuestionIndex + 1, practiceQuestions.length) : 1} 题 / 共 {practiceQuestions?.length || 0} 题</p>
                          <p className="text-white font-medium">请选择正确答案</p>
                        </div>
                      </div>
                      {practiceQuestions && practiceQuestions[currentQuestionIndex] && isQuestionAnswered(practiceQuestions[currentQuestionIndex]) && (
                        <Badge className="bg-green-500 text-white">
                          已作答
                        </Badge>
                      )}
                    </div>
                  </div>
                  <CardContent className="p-6">
                    <div className="space-y-6">
                      {practiceQuestions && practiceQuestions[currentQuestionIndex] ? (
                        <>
                          <div className="bg-gray-50 rounded-lg p-5 border-l-4 border-blue-500">
                            <p className="text-lg text-gray-800 leading-relaxed whitespace-pre-wrap">
                              {practiceQuestions[currentQuestionIndex].question || '题目加载中...'}
                            </p>
                          </div>
                          
                          {practiceQuestions[currentQuestionIndex].options && practiceQuestions[currentQuestionIndex].options.length > 0 ? (
                            <div className="space-y-3">
                              <p className="text-sm font-medium text-gray-700 mb-3">请选择一个选项：</p>
                              {practiceQuestions[currentQuestionIndex].options.map((option, index) => {
                                const currentQ = practiceQuestions[currentQuestionIndex]
                                const isSelected = currentQ && typeof currentQ.userAnswer === 'number' && currentQ.userAnswer === index
                                const optionLabel = String.fromCharCode(65 + index)
                                return (
                                  <button
                                    key={index}
                                    onClick={() => submitPracticeAnswer(currentQuestionIndex, index)}
                                    className={`w-full text-left p-4 rounded-lg border-2 transition-all duration-200 group ${
                                      isSelected
                                        ? 'border-blue-500 bg-blue-50 shadow-md'
                                        : 'border-gray-200 hover:border-blue-300 hover:bg-gray-50'
                                    }`}
                                  >
                                    <div className="flex items-start gap-3">
                                      <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shrink-0 ${
                                        isSelected
                                          ? 'bg-blue-500 text-white'
                                          : 'bg-gray-200 text-gray-600 group-hover:bg-blue-100 group-hover:text-blue-600'
                                      }`}>
                                        {optionLabel}
                                      </div>
                                      <p className={`text-base leading-relaxed ${isSelected ? 'text-blue-900 font-medium' : 'text-gray-700'}`}>
                                        {option || '选项内容'}
                                      </p>
                                    </div>
                                  </button>
                                )
                              })}
                            </div>
                          ) : (
                            <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                              <p className="text-yellow-800 text-sm">此题为简答题，暂不支持在线作答</p>
                            </div>
                          )}
                        </>
                      ) : (
                        <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                          <p className="text-red-800 text-sm">题目加载失败，请刷新页面重试</p>
                        </div>
                      )}

                      <div className="flex justify-between items-center pt-4 border-t">
                        <Button
                          variant="outline"
                          onClick={() => handleQuestionNavigation(currentQuestionIndex - 1)}
                          disabled={currentQuestionIndex === 0}
                          className="gap-2"
                        >
                          <span>←</span>
                          上一题
                        </Button>
                        
                        <div className="flex gap-1 flex-wrap justify-center max-w-[200px] overflow-x-auto">
                          {practiceQuestions.slice(0, 20).map((q, idx) => (
                            <button
                              key={idx}
                              onClick={() => handleQuestionNavigation(idx)}
                              className={`w-8 h-8 rounded text-sm font-medium transition-colors ${
                                idx === currentQuestionIndex
                                  ? 'bg-blue-600 text-white'
                                  : isQuestionAnswered(q)
                                    ? 'bg-green-100 text-green-700 hover:bg-green-200'
                                    : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                              }`}
                            >
                              {idx + 1}
                            </button>
                          ))}
                          {practiceQuestions.length > 20 && (
                            <span className="w-8 h-8 flex items-center justify-center text-xs text-gray-500">...</span>
                          )}
                        </div>

                        {currentQuestionIndex < practiceQuestions.length - 1 ? (
                          <Button
                            onClick={() => handleQuestionNavigation(currentQuestionIndex + 1)}
                            className="gap-2"
                          >
                            下一题
                            <span>→</span>
                          </Button>
                        ) : (
                          <Button
                            onClick={completePractice}
                            disabled={practiceQuestions.some(q => q && q.options && q.options.length > 0 && !isQuestionAnswered(q)) || isSubmitting}
                            className="bg-green-600 hover:bg-green-700 min-w-[120px]"
                          >
                            {isSubmitting ? (
                              <div className="flex items-center gap-2">
                                <RefreshCw className="w-4 h-4 animate-spin" />
                                <span>提交中...</span>
                              </div>
                            ) : (
                              '提交答案'
                            )}
                          </Button>
                        )}
                      </div>
                      
                      {isSubmitting && (
                        <div className="mt-4 space-y-2">
                          <div className="flex items-center justify-between text-sm text-gray-600">
                            <span>
                              {syncStatus === 'calculating' && '正在计算得分...'}
                              {syncStatus === 'submitting' && '正在提交答案...'}
                              {syncStatus === 'syncing' && '正在同步数据...'}
                              {syncStatus === 'completed' && '提交完成！'}
                              {syncStatus === 'error' && '提交失败，已保存到本地'}
                            </span>
                            <span>{submitProgress}%</span>
                          </div>
                          <Progress value={submitProgress} className="h-2" />
                          {networkStatus === 'offline' && (
                            <p className="text-xs text-orange-600 flex items-center gap-1">
                              <AlertCircle className="w-3 h-3" />
                              网络连接已断开，数据将在恢复后自动同步
                            </p>
                          )}
                        </div>
                      )}
                    </div>
                  </CardContent>
                </Card>
              </div>
            </ErrorBoundary>
