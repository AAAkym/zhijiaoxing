# Docker 忽略文件 - 前端

# 依赖目录（体积大，构建时会重新安装）
node_modules/

# 构建产物（构建时会重新生成）
dist/

# 测试和覆盖率
coverage/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo

# 环境变量
.env
.env.local
.env.*.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 临时文件
*.tmp
*.bak

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore
nginx.conf