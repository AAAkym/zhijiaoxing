# 智教星 · 后端环境变量模板
#
# 用法：复制为 backend/.env 并填入真实值。**本文件只含变量名与说明，禁止提交任何真实凭据。**
# 夜间巡查 BUG-017：仓库此前没有任何 .env.example，30+ 个变量只能靠读 config.py 反推。
#
# ⚠️ 安全提醒：backend/.env 含真实密钥，曾被 git 跟踪（巡查 SEC-001）。
# 处置顺序必须是：先轮换泄露密钥 → git rm --cached backend/.env → 再提交本模板。

# ===== 必填 · 讯飞星火大模型 =====
SPARK_API_PASSWORD=your_spark_api_password
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=ultra
# SPARK_API_KEY / SPARK_API_SECRET / SPARK_APP_ID：WebSocket 鉴权方式才需要
#SPARK_API_KEY=
#SPARK_API_SECRET=
#SPARK_APP_ID=

# ===== 必填 · Flask 会话 =====
# 生产环境必须换成足够长的随机串（轮换会使全部已登录会话失效，安排在低峰期）
SECRET_KEY=please-generate-a-long-random-string

# ===== 运行环境 =====
FLASK_ENV=development
DEBUG=true
#SQLALCHEMY_ECHO=false
DATABASE_URL=sqlite:///dev.db
#TEST_DATABASE_URL=sqlite:///:memory:
PUBLIC_BASE_URL=http://localhost:5173
#MAX_CONTENT_LENGTH=

# ===== Redis（可选：Celery 异步任务与缓存；缺失时缓存降级 SimpleCache）=====
#REDIS_HOST=127.0.0.1
#REDIS_PORT=6379
#REDIS_DB=0
#REDIS_PASSWORD=
#REDIS_URL=

# ===== 数据库（Postgres 等外部库时使用）=====
#DB_HOST=
#DB_PORT=
#DB_USER=
#DB_PASSWORD=
#DB_NAME=
#DB_POOL_SIZE=
#DB_POOL_TIMEOUT=
#DB_POOL_RECYCLE=
#DB_MAX_OVERFLOW=
#DB_POOL_PRE_PING=

# ===== Elasticsearch（可选：搜索引擎）=====
#ELASTICSEARCH_ENABLED=false
#ELASTICSEARCH_HOST=
#ELASTICSEARCH_PORT=
#ELASTICSEARCH_USERNAME=
#ELASTICSEARCH_PASSWORD=
#ELASTICSEARCH_CONNECTION_TIMEOUT=
#ELASTICSEARCH_RETRY_COUNT=
#ELASTICSEARCH_RETRY_DELAY=

# ===== 讯飞智能 PPT（可选）=====
# ⚠️ config.py 曾对这两项内置硬编码默认值（巡查 SEC-002），务必显式覆盖
#XFYUN_PPT_APP_ID=
#XFYUN_PPT_API_SECRET=
#XFYUN_PPT_API_BASE=
#XFYUN_PPT_POLL_INTERVAL=
#XFYUN_PPT_MAX_WAIT=

# ===== 缓存调优（可选，均有默认值）=====
#CACHE_TYPE=SimpleCache
#CACHE_DEFAULT_TIMEOUT=
#CACHE_SESSION_TIMEOUT=
#CACHE_COURSES_TIMEOUT=
#CACHE_CONTENT_TIMEOUT=
#CACHE_ASSESSMENT_TIMEOUT=
#CACHE_STATS_TIMEOUT=
#CACHE_KEY_PREFIX=

# ===== 会话 / 服务 =====
#SESSION_COOKIE_SECURE=
#SESSION_FILE_DIR=
