          }
        }
      },
      "applications": {
        "type": "text",
        "analyzer": "ik_smart_custom"
      },
      "examples": {
        "type": "nested",
        "properties": {
          "title": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "content": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "code": {
            "type": "text",
            "index": false
          }
        }
      },
      "references": {
        "type": "nested",
        "properties": {
          "title": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "url": {
            "type": "keyword",
            "index": false
          },
          "type": {
            "type": "keyword"
          }
        }
      },
      "attachments": {
        "type": "nested",
        "properties": {
          "id": {
            "type": "keyword"
          },
          "name": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "url": {
            "type": "keyword",
            "index": false
          },
          "type": {
            "type": "keyword"
          }
        }
      },
      "view_count": {
