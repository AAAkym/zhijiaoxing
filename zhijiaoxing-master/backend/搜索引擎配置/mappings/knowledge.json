        "index": true
      },
      "confidence_score": {
        "type": "float",
        "index": true
      },
      "accuracy_score": {
        "type": "float"
      },
      "quality_score": {
        "type": "float"
      },
      "is_verified": {
        "type": "boolean",
        "index": true
      },
      "is_published": {
        "type": "boolean",
        "index": true
      },
      "status": {
        "type": "keyword",
        "index": true
      },
      "visibility": {
        "type": "keyword",
        "index": true
      },
      "language": {
        "type": "keyword",
