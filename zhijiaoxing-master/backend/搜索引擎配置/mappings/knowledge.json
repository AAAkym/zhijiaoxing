{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "ik_smart_custom": {
          "type": "custom",
          "tokenizer": "ik_smart",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "ik_max_word_custom": {
          "type": "custom",
          "tokenizer": "ik_max_word",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "synonym_analyzer": {
          "type": "custom",
          "tokenizer": "ik_smart",
          "filter": [
            "lowercase",
            "asciifolding",
            "synonym_filter"
          ]
        },
        "qa_analyzer": {
          "type": "custom",
          "tokenizer": "ik_max_word",
          "filter": [
            "lowercase",
            "asciifolding",
            "synonym_filter"
          ]
        }
      },
      "filter": {
        "asciifolding": {
          "type": "asciifolding",
          "preserve_original": true
        },
        "synonym_filter": {
          "type": "synonym",
          "synonyms_path": "analysis/synonyms.txt",
          "ignore_case": true,
          "expand": true
        }
      }
    },
    "index": {
      "max_result_window": 10000,
      "refresh_interval": "5s",
      "similarity": {
        "default": {
          "type": "BM25",
          "b": 0.75,
          "k1": 1.2
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": {
        "type": "keyword",
        "index": true,
        "store": true
      },
      "title": {
        "type": "text",
        "analyzer": "ik_max_word_custom",
        "search_analyzer": "ik_smart_custom",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          },
          "synonym": {
            "type": "text",
            "analyzer": "synonym_analyzer"
          }
        },
        "boost": 3.0
      },
      "question": {
        "type": "text",
        "analyzer": "qa_analyzer",
        "search_analyzer": "synonym_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 512
          }
        },
        "boost": 3.5
      },
      "answer": {
        "type": "text",
        "analyzer": "ik_max_word_custom",
        "search_analyzer": "ik_smart_custom",
        "store": false,
        "term_vector": "with_positions_offsets"
      },
      "answer_summary": {
        "type": "text",
        "analyzer": "ik_smart_custom",
        "boost": 2.0
      },
      "content": {
        "type": "text",
        "analyzer": "ik_max_word_custom",
        "search_analyzer": "ik_smart_custom",
        "store": false
      },
      "knowledge_type": {
        "type": "keyword",
        "index": true
      },
      "category": {
        "type": "keyword",
        "index": true,
        "fields": {
          "text": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          }
        }
      },
      "sub_category": {
        "type": "keyword",
        "index": true
      },
      "tags": {
        "type": "keyword",
        "index": true,
        "boost": 1.5
      },
      "keywords": {
        "type": "keyword",
        "index": true,
        "boost": 2.0
      },
      "entities": {
        "type": "nested",
        "properties": {
          "name": {
            "type": "keyword",
            "boost": 2.5
          },
          "type": {
            "type": "keyword"
          },
          "relevance": {
            "type": "float"
          }
        }
      },
      "concepts": {
        "type": "nested",
        "properties": {
          "name": {
            "type": "keyword",
            "boost": 2.0
          },
          "definition": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "related_concepts": {
            "type": "keyword"
          }
        }
      },
      "related_questions": {
        "type": "nested",
        "properties": {
          "question": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "relevance_score": {
            "type": "float"
          }
        }
      },
      "source": {
        "properties": {
          "type": {
            "type": "keyword"
          },
          "id": {
            "type": "keyword"
          },
          "title": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          },
          "url": {
            "type": "keyword",
            "index": false
          },
          "author": {
            "type": "text",
            "analyzer": "ik_smart_custom"
          }
        }
      },
      "author": {
        "properties": {
