# 智教星 Docker 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ==================== Spark API 配置（必填） ====================
# 讯飞星火大模型 API 密钥
SPARK_API_PASSWORD=your_spark_api_password_here

# Spark API 地址（可选，已有默认值）
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# Spark 模型版本（可选，已有默认值）
# 可选值：lite, general, pro, ultra
SPARK_MODEL=lite

# ==================== 安全配置 ====================
# Flask 密钥（生产环境请修改）
SECRET_KEY=zhijiaoxing-secret-key-change-in-production